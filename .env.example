# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=ko

# Database — default: Supabase (D0~). Docker is optional offline.
# Prefer Session pooler (IPv4). Direct db.*.supabase.co is often IPv6-only.
# Dashboard → Database → Connect → Session mode (port 5432)
# Username must be postgres.[PROJECT_REF]
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-1-[region].pooler.supabase.com:6543/postgres?sslmode=require
DB_PROVIDER=supabase
# Session mode (port 5432) also works — copy exact host from Dashboard → Connect
# Direct (IPv6-only on many networks — may fail with ENOTFOUND):
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require

# Optional offline:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ywamfund
# DB_PROVIDER=local

# Auth (D2)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Toss Phase 1 (D2)
TOSS_SECRET_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_WEBHOOK_SECRET=
PAYMENT_PROVIDERS_ENABLED=toss

# Observability / email (wire in D2)
RESEND_API_KEY=
RESEND_FROM=
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CRON_SECRET=
